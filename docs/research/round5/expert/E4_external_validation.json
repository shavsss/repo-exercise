{
  "id": "E4_external_validation",
  "date": "2026-10-30",
  "principle": "External validation = someone independent runs, reads, or examines the work. Prefer channels that judge judgment (paper review, PR review, oral exam, paying customer) over output-only leaderboards. Two distinct channels per level.",
  "channels": [
    {"cat": "competition", "name": "IEEE Signal Processing Cup", "certifies": "ranking vs student teams, final at ICASSP", "cost": "free", "time": "3-5 months", "prereq": "student team via institution", "cred": {"industry": "mid", "defense": "low", "academia": "high"}, "status": "2027 final ICASSP Toronto 16-21.5.2027; topic varies", "tag": "evidence", "url": "https://signalprocessingsociety.org/newsletter/2026/07/call-proposals-organize-prestigious-sp-cup-2027"},
