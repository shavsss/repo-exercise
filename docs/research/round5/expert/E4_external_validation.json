    {"cat": "competition", "name": "Google Smartphone Decimeter Challenge (Kaggle/ION)", "certifies": "GNSS/IMU positioning accuracy vs ground truth; paper for winners", "cost": "free", "time": "8 months", "cred": {"industry": "high-PNT", "defense": "mid", "academia": "high"}, "status": "3rd edition 9.2023-5.2024; no 4th found; data usable as private benchmark", "tag": "evidence", "url": "https://www.ion.org/gnss/googlecompetition.cfm"},
    {"cat": "competition", "name": "MAFAT Challenge", "certifies": "ranking on Israeli defense data (2020 radar human/animal, I/Q)", "cost": "free", "time": "3 months", "cred": {"industry": "high-IL", "defense": "very high-IL", "academia": "mid"}, "status": "series active, announces via mailing list; 2020 radar on CodaLab", "tag": "evidence", "url": "https://mafatchallenge.mod.gov.il"},
    {"cat": "competition", "name": "DARPA challenges", "status": "AIxCC ended DEF CON 33 (8.2025); Triage finals 11.2026; no open wave-1 challenge", "tag": "evidence", "url": "https://www.darpa.mil/news/2025/aixcc-results"},
    {"cat": "competition", "name": "DEF CON RF Village CTF / Aerospace Village Starpwn", "certifies": "hands-on RF/SDR and space-system exploitation", "cost": "remote play possible", "cred": {"industry": "mid", "defense": "mid", "academia": "low"}, "status": "Hack-A-Sat last 2023 (HAS4); Starpwn 6-9.8.2026 online", "tag": "evidence", "url": "https://ctftime.org/event/3342/"},
