    {"level": "junior", "months_est": "6-12", "signals": ["2-3 Open University courses with grades", "amateur radio license", "2-3 merged small PRs (GNU Radio/GNSS-SDR)", "full Decimeter/MAFAT radar solution on public data vs winners"]},
    {"level": "mid", "months_est": "12-24", "signals": ["feature in GNSS-SDR or gr-radar block", "RF CTF top 25%", "INCOSE ASEP", "paid review of design report by radar engineer", "GSoC", "talk at GRCon or IACAS"]},
    {"level": "senior", "months_est": "24-40", "signals": ["2-3 peer-reviewed conference papers (RadarConf, ION GNSS+, EuRAD, COMCAS, IEEE Aerospace)", "high rank in live competition (MAFAT, Radar Challenge)", "oral exam by professor", "JOSS for tool with users"]},
    {"level": "expert", "months_est": "40-60", "signals": ["IEEE/ION reviewer", "journal paper (TAES, TSP, NAVIGATION)", "maintainer/committer", "funded AESS Challenge Problem solution", "citations by others", "paying customers"]},
    {"level": "principal", "months_est": "60+", "signals": ["organizes competition/challenge problem", "session chair, invited tutorial", "paid consulting for organization", "product with recurring revenue", "analyst: 2-year public Brier record + WOTR"]}
